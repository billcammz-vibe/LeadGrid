# Google — server-side only, no VITE_ prefix, never exposed to the browser. One key, used by the
# api/places-search, api/geocode, and api/site-audit proxies. In Google Cloud: enable "Places API
# (New)", "Geocoding API", and "PageSpeed Insights API", then create an API key with NO
# application/referrer restriction (server-to-server calls can't send one) and API-restrict it to
# just those three. There is no client-side map, so no Maps JavaScript API key or Map ID is needed.
# (PageSpeed Insights also works unauthenticated at a much lower quota if this key is unset.)
GOOGLE_PLACES_API_KEY=

# Server-side only. Claude — per-lead outreach email drafting (api/generate-email).
# From console.anthropic.com. Never sent to the browser.
ANTHROPIC_API_KEY=

# Server-side only. Social-link enrichment (Instagram/Facebook lookup). From tavily.com.
TAVILY_API_KEY=

# Supabase — Project Settings > API. Both are safe to expose client-side (the anon key is meant
# to be public — every table is protected by RLS, "authenticated only"). Also read server-side by
# api/lib/requireAuth.js to validate the bearer token on the Places/socials/geocode proxies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Local dev auto-login — src/main.js signs in silently as this user so the login screen
# never shows. Must be a real, confirmed Supabase Auth user. Omit both to use the login screen.
VITE_DEV_EMAIL=
VITE_DEV_PASSWORD=
